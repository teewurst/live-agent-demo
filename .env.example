OPENAI_API_KEY=sk-your-key-here
# Optional test/proxy override. Keep the default for normal OpenAI API usage.
OPENAI_BASE_URL=https://api.openai.com/v1
# Comma-separated MCP server endpoints for tool discovery (stateful CRM mock)
MCP_SERVER_URLS=http://crm-mcp:3010/mcp
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-03-20
OPENAI_TTS_VOICE=shimmer
OPENAI_TTS_FORMAT=mp3

OPENAI_AGENT_MODEL=gpt-5.4-nano
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=shimmer
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# default | latency_ux — see agentPrompt.latencyUx.ts
AGENT_PROMPT_VARIANT=default
# default | latency_ux — see liveAgentPrompt.latencyUx.ts
LIVE_AGENT_PROMPT_VARIANT=default
AGENT_MAX_TOOL_CALLS=8
AGENT_LOG_ENABLED=true
AGENT_LOG_DIR=./logs/agent-turns

# Demo passwords for local fallback and MCP mock validate server
DEMO_CUSTOMER_PASSWORDS={"12345":"9876","67890":"horizon42"}

PHRASE_MAX_CHARS=800
PHRASE_MIN_CHARS=120
PHRASE_FLUSH_ON_NEWLINE=true
TTS_WHOLE_MESSAGE_MAX_CHARS=800
